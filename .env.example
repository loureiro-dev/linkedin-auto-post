# Token do MCP oficial do n8n (Settings > n8n API / MCP no n8n).
# Não vai num arquivo .env de verdade neste projeto -- o Claude Code não
# carrega .env sozinho. O valor real fica numa variável de ambiente do
# Windows a nível de usuário (reaproveitada por todos os projetos que
# falarem com essa mesma instância n8n), setada uma vez fora do repo.
N8N_MCP_TOKEN=

# ID da sua planilha "Backlog LinkedIn" no Google Sheets (pegue na URL:
# docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
LINKEDIN_SHEET_ID=SEU_SHEET_ID_AQUI

# chat_id do Telegram que recebe as aprovações (fale com @get_id_bot no
# Telegram pra descobrir o seu)
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI

# Seu LinkedIn person URN (formato usado pelo node LinkedIn do n8n,
# obtido ao autenticar a credencial LinkedIn OAuth2 no n8n)
LINKEDIN_PERSON_URN=SEU_PERSON_URN_AQUI

# URL pública do n8n (necessária pros nodes Telegram sendAndWait
# funcionarem -- veja um túnel público tipo Cloudflare Tunnel ou ngrok)
N8N_WEBHOOK_URL=https://SEU_DOMINIO_AQUI/
